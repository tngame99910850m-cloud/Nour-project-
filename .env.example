# ============================================================
#  Nour Boutique — Environment Variables
#  Copy this file to `.env` for local development.
#  On Vercel, add these in Project Settings → Environment Variables.
# ============================================================

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string. For Vercel Postgres / Supabase / Neon use the
# pooled connection string for DATABASE_URL and the direct one for DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nour?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nour?schema=public"

# --- Authentication (required) ---------------------------------------------
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Credentials for the first admin/owner account created by the seed script.
SEED_OWNER_EMAIL="owner@nourboutique.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
SEED_DEVELOPER_EMAIL="developer@nourboutique.com"
SEED_DEVELOPER_PASSWORD="ChangeMe123!"

# --- Public site URL (required in production) -------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (optional — configurable from Developer Dashboard too) -------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Email (optional — for order notifications, future use) -----------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="orders@nourboutique.com"

# --- Payments (optional — integration scaffolding) -------------------------
# Never expose secret keys to the client. Only NEXT_PUBLIC_* is client-visible.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
